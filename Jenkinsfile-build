pipeline {
    agent any

    environment {
        DOCKER_IMAGE_NAME = "notetakingapp"
        DOCKER_IMAGE_TAG = "latest"
        MYSQL_ROOT_PASSWORD = "${MYSQL_ROOT_PASSWORD}"
        MYSQL_DATABASE = 'note_taking_app'
        MYSQL_USER = "${MYSQL_USER}"
        MYSQL_PASSWORD = "${MYSQL_PASSWORD}"
        MYSQL_HOST = 'mariadb'
    }

    stages {
        stage('Checkout') {
            steps {
                // Clone the repository
                git branch: 'main', url: 'https://github.com/randycl/notetakingapp.git'
            }
        }

         stage('Build') {
            agent {
                docker {
                    image 'maven:3.8.4-openjdk-17'
                    args '-v $HOME/.m2:/root/.m2 -v ./app:/app --network=mynetwork'
                }
            }
            steps {
                dir('note-taking-app/note-taking-app') {
                    sh 'mvn clean package'
                    sh 'cp ./target/note*.jar /app/notetakingapp.jar'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                // Build the Docker image from the correct context
                sh """
                docker build -t ${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG} -f Dockerfile .
                """

            }
        }

    stage('Run Docker Container') {
        steps {
            sh """
            # Check if container is already running
            if [ \$(docker ps -q -f name=${DOCKER_IMAGE_NAME}) ]; then
                echo "Container ${DOCKER_IMAGE_NAME} is already running."
            elif [ \$(docker ps -aq -f name=${DOCKER_IMAGE_NAME}) ]; then
                echo "Container ${DOCKER_IMAGE_NAME} exists but is not running. Starting it..."
                docker start ${DOCKER_IMAGE_NAME}
            else
                echo "No existing container. Creating a new one..."
                docker run -d --name ${DOCKER_IMAGE_NAME} \\
                    -e MYSQL_USER=${MYSQL_USER} \\
                    -e MYSQL_PASSWORD=${MYSQL_PASSWORD} \\
                    --network mynetwork \\
                    -p 8080:8080 \\
                    -v /app:/app \\
                    ${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}
            fi
            """

            // Optional: print environment and logs
            sh """
            docker exec ${DOCKER_IMAGE_NAME} env || true
            docker logs ${DOCKER_IMAGE_NAME} || true
            """
        }
    }
}
    post {
        always {
            // Clean up Docker containers
            //sh """
            //docker stop ${DOCKER_IMAGE_NAME} || true
            //docker rm ${DOCKER_IMAGE_NAME} || true
            //"""
            archiveArtifacts artifacts: '**/target/*.jar', allowEmptyArchive: true
            junit '**/target/surefire-reports/*.xml'
        }
        success {
            echo 'Build and Docker packaging successful!'
        }
        failure {
            echo 'Build or Docker packaging failed.'
        }
    }
}
